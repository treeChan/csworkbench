# Workbench 配置示例。
#
# 一般不用手动改这个文件 —— 用 ./run.sh --data <文件夹> 启动时
# 会自动生成 .env。想手动改的话:把本文件复制成 .env 再编辑。
#
# 所有变量都以 WORKBENCH_ 前缀开头。

# ---- 数据库位置 ----
# 支持三种写法:
#   data/workbench.db              相对项目根目录(默认)
#   /Users/你的名字/科研数据/wb.db    绝对路径
#   ~/Documents/科研数据/wb.db       家目录
#
# 提示:填到网盘/同步盘的目录里,数据就能自动备份。
# Windows 用户请用正斜杠,例如 D:/科研数据/wb.db
WORKBENCH_DB_PATH=data/workbench.db

# ---- 应用名 ----
# 显示在浏览器标签页和界面左上角。
# 多人各自跑一份时,可以改成自己的名字以便区分。
WORKBENCH_APP_NAME=Workbench

# ---- 上传文件存哪里 ----
# 图片、模型权重、附件都落在这里。三种写法都支持(相对/绝对/~)，
# Windows 上请用正斜杠,例如 D:/科研数据/artifacts
WORKBENCH_ARTIFACT_DIR=data/artifacts

# ---- 单个上传文件最大多少 MB ----
# 防止误传几个 G 的数据集把硬盘塞满。默认 100 MB。
WORKBENCH_MAX_UPLOAD_SIZE_MB=100

# ---- 以下两项目前尚未接线 ----
# 它们在 app/config.py 里已声明,但代码中还没有实际使用:
#   WORKBENCH_DEBUG      本想用来让 SQLAlchemy 打印 SQL,但 database.py 里
#                        echo 是写死的 False,所以改这个值不会有任何效果
#   WORKBENCH_PAGE_SIZE  本想用来控制分页,但目前查询都没用它
# 保留声明是为了以后接上,现在设置它们不起作用。

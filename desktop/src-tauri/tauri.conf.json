{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "csworkbench",
  "version": "0.4.3",
  "identifier": "com.csworkbench.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Workbench · 研究驾驶舱",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/workbench-server"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local research workbench desktop app"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDNCNEY2RjdGQjU1RUMKUldUc1ZmdjM5clRUT05WdmppZWQ2VTh1R1JGY3p4WXkwdmhaZjI5REJUNVJ3RmgwNlI3UWExakMK",
      "endpoints": ["https://github.com/treeChan/csworkbench/releases/latest/download/latest.json"]
    }
  }
}
